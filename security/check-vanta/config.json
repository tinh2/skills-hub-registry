{
  "vulnerability_source": "vanta",
  "issue_tracker": "jira",
  "commit_suffix": "deploy:username",
  "vanta": {
    "token_file": "~/.vanta-token",
    "token_env": "VANTA_API_TOKEN",
    "api_base": "https://api.vanta.com/v1"
  },
  "jira": {
    "url": "https://your-org.atlassian.net",
    "project_key": "DEV",
    "issue_type": "Story",
    "credentials_file": "~/.jira-credentials"
  },
  "github": {
    "org": "your-github-org"
  },
  "repos": {
    "example-api": {
      "path": "/path/to/your/repo/example-api",
      "package_manager": "npm"
    },
    "example-lambdas": {
      "path": "/path/to/your/repo/example-lambdas",
      "package_manager": "npm",
      "package_json_path": "layers/util/nodejs"
    },
    "example-utilities": {
      "path": "/path/to/your/repo/example-utilities",
      "package_manager": "npm"
    },
    "example-app": {
      "path": "/path/to/your/repo/example-app",
      "package_manager": "yarn"
    }
  }
}
