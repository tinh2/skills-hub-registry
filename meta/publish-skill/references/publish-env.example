# Copy to ~/.claude/state/skills-hub-publish.env and fill in. chmod 600.
# This file is local-only and must never be committed or published.
SKILLS_HUB_AWS_PROFILE=your-aws-profile
SKILLS_HUB_AWS_REGION=us-east-1
SKILLS_HUB_DB_SECRET_ID=path/to/your/db-password-secret
SKILLS_HUB_DB_HOST=your-db-host
SKILLS_HUB_DB_PORT=5432
SKILLS_HUB_DB_USER=your-db-user
SKILLS_HUB_DB_NAME=your-db-name
SKILLS_HUB_REGISTRY_DIR=$HOME/git/your-registry
SKILLS_HUB_PLATFORM_DIR=$HOME/git/your-platform
SKILLS_HUB_SOURCE_SLUG=your-source-slug
